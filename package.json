{
  "name": "metasocli",
  "version": "0.1.0",
  "description": "Independent local story and Metaso H3 video task CLI",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "node": ">=24.0.0" },
  "bin": { "metasocli": "dist/cli/main.js" },
