{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true,
    "rootDir": "src", "outDir": "dist", "declaration": true,
    "sourceMap": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
